# The macOS base every image is built on. The workflows load this file into their
# environment. See docs/macos-experimental.md#base-image.
#
# TART_BASE is Cirrus Labs' vanilla image, pinned by digest. Cirrus Labs names
# macOS 27 "Golden Gate", so look for macos-golden-gate-vanilla, not macos-27.
TART_BASE=ghcr.io/cirruslabs/macos-golden-gate-vanilla:27.2@sha256:b35695ce30453bcc1db961a476740be72a44c2a2e464b73ece1ff0fcac12a873
# The same disk in hypeman's registry, as builds/BASE_NAME. The macOS base workflow
# publishes it and prints BASE_DIGEST.
BASE_NAME=macos-27-2
BASE_DIGEST=
